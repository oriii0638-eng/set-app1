{
  "name": "set-ios",
  "version": "1.0.0",
  "private": true,
  "description": "עטיפת iOS ואנדרואיד (Capacitor) לאפליקציית סט",
  "scripts": {
    "add:ios": "npx cap add ios",
    "assets": "npx capacitor-assets generate --ios",
    "sync": "npx cap sync ios",
    "open": "npx cap open ios",
    "mac": "bash build-on-mac.sh",
    "add:android": "npx cap add android",
    "sync:android": "npx cap sync android",
    "open:android": "npx cap open android",
    "android": "bash build-android.sh"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/native-purchases": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capgo/capacitor-health": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.0.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.0.0"
  }
}